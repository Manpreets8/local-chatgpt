# Copy this file to .env and fill in real values.
# Never commit the real .env file.

# --- App ---
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-long-random-string

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-sonnet-5

# --- Image generation ---
# Uses Pollinations.ai (image.pollinations.ai) — free, keyless, no config needed.

# --- Database (PostgreSQL) ---
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=personal_ai_agent
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://chatbot:change-me@localhost:5432/personal_ai_agent

# --- Auth / JWT ---
JWT_SECRET_KEY=change-me-to-a-different-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---
CORS_ORIGINS=http://localhost:5173

# --- Email (Gmail SMTP — welcome email on signup) ---
# SMTP_USERNAME is your full Gmail address. SMTP_PASSWORD is a 16-character
# "App Password" from https://myaccount.google.com/apppasswords (requires
# 2-Step Verification enabled on the account) — NOT your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail-address@gmail.com
SMTP_PASSWORD=your-16-character-app-password
FRONTEND_URL=http://localhost:5173
