# Copy this file to .env and fill in real values.
# Never commit the real .env file.

# --- App ---
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-long-random-string

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-sonnet-5

# --- Database (PostgreSQL) ---
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=personal_ai_agent
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://chatbot:change-me@localhost:5432/personal_ai_agent

# --- Auth / JWT ---
JWT_SECRET_KEY=change-me-to-a-different-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---
CORS_ORIGINS=http://localhost:5173
